@model GLMS.Web.Models.ServiceRequest
@{
    ViewData["Title"] = "Edit Service Request";
}

<h1>Edit Service Request #@Model.ServiceRequestId</h1>
<p class="text-muted">
    Contract #@Model.ContractId - @Model.ClientName ·
    $@Model.CostUsd.ToString("N2") = R @Model.CostZar.ToString("N2") (costs are fixed once saved)
</p>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.ServiceRequestId" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ServiceRequestId" />

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select"
                        asp-items="Html.GetEnumSelectList<GLMS.Web.Models.ServiceRequestStatus>()"></select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="ms-2">Back to List</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}