@model GLMS.Web.Models.ServiceRequest

@{
    ViewData["Title"] = "Create";
}

<h1>Raise Service Request</h1>

<h4>ServiceRequest</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="ContractId" class="control-label"></label>
                <select asp-for="ContractId" class ="form-control" asp-items="ViewBag.ContractId"></select>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CostUsd" class="control-label"></label>
                <input asp-for="CostUsd" class="form-control" />
                <span asp-validation-for="CostUsd" class="text-danger"></span>
            </div>

            @{
                var usdToZarRate = ViewData["UsdToZarRate"] as decimal?;
            }
            <div class="form-group mb-3">
                <label class="control-label">Cost (ZAR)</label>
                <input id="costZarPreview" class="form-control" readonly />
                @if (usdToZarRate.HasValue)
                {
                    <small class="text-muted">
                        Live rate: 1 USD = R @usdToZarRate.Value.ToString("0.0000", System.Globalization.CultureInfo.InvariantCulture)
                        · <a href="https://www.exchangerate-api.com" target="_blank">Rates By Exchange Rate API</a>
                    </small>
                }
                else
                {
                    <small class="text-warning">The live rate is unavailable right now. The ZAR cost will be calculated when you save.</small>
                }
            </div>
            
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function () {
            const rate = @((ViewData["UsdToZarRate"] as decimal?)?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "null");
            const usdInput = document.getElementById("CostUsd");
            const zarOutput = document.getElementById("costZarPreview");

            if (!usdInput || !zarOutput || rate === null) return;

            function updateZar() {
                const usd = parseFloat(usdInput.value);
                zarOutput.value = isNaN(usd) ? "" : "R " + (usd * rate).toFixed(2);
            }

            usdInput.addEventListener("input", updateZar);
            updateZar();
        })();
    </script>
}
