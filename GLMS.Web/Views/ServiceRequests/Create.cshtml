@model GLMS.Web.Models.ServiceRequest
@{
    ViewData["Title"] = "Raise Service Request";
    var usdToZarRate = ViewData["UsdToZarRate"] as decimal?;
}

<h1>Raise Service Request</h1>
<p class="text-muted">Requests can only be raised against Active contracts.</p>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="ContractId" class="form-label"></label>
                <select asp-for="ContractId" class="form-select" asp-items="ViewBag.ContractId">
                    <option value="">-- Select a contract --</option>
                </select>
                <span asp-validation-for="ContractId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CostUsd" class="form-label"></label>
                <input asp-for="CostUsd" type="number" step="0.01" min="0.01" class="form-control" />
                <span asp-validation-for="CostUsd" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Cost (ZAR)</label>
                <input id="costZarPreview" class="form-control" readonly />
                @if (usdToZarRate.HasValue)
                {
                    <small class="text-muted">
                        Live rate: 1 USD = R @usdToZarRate.Value.ToString("0.0000", System.Globalization.CultureInfo.InvariantCulture)
                        · <a href="https://www.exchangerate-api.com" target="_blank">Rates By Exchange Rate API</a>
                    </small>
                }
                else
                {
                    <small class="text-warning">The live rate is unavailable right now. The ZAR cost will be calculated when you save.</small>
                }
            </div>

            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-action="Index" class="ms-2">Back to List</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function () {
            const rate = @(usdToZarRate?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "null");
            const usdInput = document.getElementById("CostUsd");
            const zarOutput = document.getElementById("costZarPreview");

            if (!usdInput || !zarOutput || rate === null) return;

            function updateZar() {
                const usd = parseFloat(usdInput.value);
                zarOutput.value = isNaN(usd) ? "" : "R " + (usd * rate).toFixed(2);
            }

            usdInput.addEventListener("input", updateZar);
            updateZar();
        })();
    </script>
}