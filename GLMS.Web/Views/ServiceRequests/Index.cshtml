@model IEnumerable<GLMS.Web.Models.ServiceRequest>
@{
    ViewData["Title"] = "Service Requests";
}

<h1>Service Requests</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Contract</th>
            <th>Description</th>
            <th>Cost (USD)</th>
            <th>Exchange Rate</th>
            <th>Cost (ZAR)</th>
            <th>Status</th>
            <th>Created</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>#@item.ContractId - @item.ClientName</td>
                <td>@item.Description</td>
                <td>$@item.CostUsd.ToString("N2")</td>
                <td>@item.ExchangeRate.ToString("0.0000")</td>
                <td>R @item.CostZar.ToString("N2")</td>
                <td>@item.Status</td>
                <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ServiceRequestId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.ServiceRequestId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.ServiceRequestId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>