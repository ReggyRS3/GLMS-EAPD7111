@model GLMS.Web.Models.ServiceRequest
@{
    ViewData["Title"] = "Delete service request";
}

<h1>Delete service request #@Model.ServiceRequestId</h1>
<h4 class="text-danger">Are you sure you want to delete this request?</h4>
<hr />

<dl class="row">
    <dt class="col-sm-3">Contract</dt>
    <dd class="col-sm-9">#@Model.ContractId - @Model.ClientName</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>

    <dt class="col-sm-3">Cost (ZAR)</dt>
    <dd class="col-sm-9">R @Model.CostZar.ToString("N2")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.ServiceRequestId" method="post">
    <button type="submit" class="btn btn-danger">Delete</button> |
    <a asp-action="Index">Back to List</a>
</form>