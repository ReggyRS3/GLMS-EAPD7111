@model IEnumerable<GLMS.Web.Models.ManagerAlert>
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="mb-4">GLMS Dashboard</h1>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-success">
            <div class="card-body">
                <div class="text-muted">Active contracts</div>
                <div class="fs-2 fw-bold">@ViewData["ActiveCount"]</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-warning">
            <div class="card-body">
                <div class="text-muted">On hold</div>
                <div class="fs-2 fw-bold">@ViewData["OnHoldCount"]</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-danger">
            <div class="card-body">
                <div class="text-muted">Expired</div>
                <div class="fs-2 fw-bold">@ViewData["ExpiredCount"]</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-primary">
            <div class="card-body">
                <div class="text-muted">Pending requests</div>
                <div class="fs-2 fw-bold">@ViewData["PendingCount"]</div>
            </div>
        </div>
    </div>
</div>

<h4>Manager alerts</h4>
@if (!Model.Any())
{
    <p class="text-muted">No new alerts.</p>
}
else
{
    <ul class="list-group">
        @foreach (var alert in Model)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <a asp-controller="Contracts" asp-action="Details" asp-route-id="@alert.ContractId">@alert.Message</a>
                    <div class="small text-muted">@alert.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                </div>
                <form asp-action="DismissAlert" asp-route-id="@alert.ManagerAlertId" method="post">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Dismiss</button>
                </form>
            </li>
        }
    </ul>
}